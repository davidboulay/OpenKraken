.venv/
__pycache__/
*.pyc
*.egg-info/

# .deb build artifacts (regenerated by packaging/build-deb.sh)
packaging/build/
packaging/dist/

# Arch build artifacts (regenerated by packaging/arch/build-pkg.sh / makepkg)
packaging/arch/dist/
packaging/arch/pkg/
packaging/arch/src/
packaging/arch/*.pkg.tar.*
